@model SalesInvoiceSystem.Models.Sale
@{
    ViewData["Title"] = Model.Id == 0 ? "Create Invoice" : "Edit Invoice";
    var products =
        ViewBag.Products as IEnumerable<SalesInvoiceSystem.Models.Product>
        ?? Enumerable.Empty<SalesInvoiceSystem.Models.Product>();
    var customers =
        ViewBag.Customers as IEnumerable<SalesInvoiceSystem.Models.Customer>
        ?? Enumerable.Empty<SalesInvoiceSystem.Models.Customer>();
}
<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-primary text-white">
            <h3 class="mb-0">
                @(Model.Id == 0 ? "Create Invoice" : "Edit Invoice")
            </h3>
        </div>
        <div class="card-body">
            <form asp-action="CreateOrEdit" method="post" id="saleForm">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>
                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label asp-for="InvoiceNo" class="form-label">
                            Invoice No
                        </label>
                        <input asp-for="InvoiceNo"
                               class="form-control"
                               readonly />
                        <span asp-validation-for="InvoiceNo"
                              class="text-danger">
                        </span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="CustomerId" class="form-label">
                            Customer
                        </label>
                        <select asp-for="CustomerId"
                                class="form-select">
                            <option value="">
                                -- Select Customer --
                            </option>
                            @foreach (var customer in customers)
                            {
                                <option value="@customer.Id">
                                    @customer.CustomerName
                                </option>
                            }
                        </select>
                        <span asp-validation-for="CustomerId"
                              class="text-danger">
                        </span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="SaleDate" class="form-label">
                            Sale Date
                        </label>
                        <input asp-for="SaleDate"
                               type="datetime-local"
                               class="form-control" />
                        <span asp-validation-for="SaleDate"
                              class="text-danger">
                        </span>
                    </div>
                </div>
                <hr />
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h4>Add Product</h4>
                    <button type="button"
                            id="addProduct"
                            class="btn btn-primary">
                        + Add Product
                    </button>
                </div>
                <div id="productForms">
                    @if (Model.SaleDetails != null && Model.SaleDetails.Any())
                    {
                        var index = 0;
                        foreach (var detail in Model.SaleDetails)
                        {
                            <div class="product-form border rounded p-3 mb-3">
                                <div class="row align-items-end">
                                    <div class="col-md-5">
                                        <label class="form-label">
                                            Product
                                        </label>
                                        <select class="form-select product-select">
                                            <option value="">
                                                -- Select Product --
                                            </option>
                                            @foreach (var product in products)
                                            {
                                                if (product.Id == detail.ProductId)
                                                {
                                                    <option value="@product.Id"
                                                            data-price="@product.Price"
                                                            data-stock="@product.Stock"
                                                            selected>
                                                        @product.ProductName - Stock: @product.Stock
                                                    </option>
                                                }
                                                else
                                                {
                                                    <option value="@product.Id"
                                                            data-price="@product.Price"
                                                            data-stock="@product.Stock">
                                                        @product.ProductName - Stock: @product.Stock
                                                    </option>
                                                }
                                            }
                                        </select>
                                    </div>
                                    <div class="col-md-2">
                                        <label class="form-label">
                                            Quantity
                                        </label>
                                        <input type="number"
                                               class="form-control quantity-input"
                                               value="@detail.Quantity"
                                               min="1" />
                                    </div>
                                    <div class="col-md-2">
                                        <label class="form-label">
                                            Unit Price
                                        </label>
                                        <input type="number"
                                               class="form-control unit-price-input"
                                               value="@detail.UnitPrice"
                                               step="0.01"
                                               readonly />
                                    </div>
                                    <div class="col-md-2">
                                        <label class="form-label">
                                            Total
                                        </label>
                                        <input type="number"
                                               class="form-control total-price-input"
                                               value="@detail.TotalPrice"
                                               step="0.01"
                                               readonly />
                                    </div>
                                    <div class="col-md-1">
                                        <button type="button"
                                                class="btn btn-danger remove-product">
                                            X
                                        </button>
                                    </div>
                                </div>
                            </div>
                            index++;
                        }
                    }
                    else
                    {
                        <div class="product-form border rounded p-3 mb-3">
                            <div class="row align-items-end">
                                <div class="col-md-5">
                                    <label class="form-label">
                                        Product
                                    </label>
                                    <select class="form-select product-select">
                                        <option value="">
                                            -- Select Product --
                                        </option>
                                        @foreach (var product in products)
                                        {
                                            <option value="@product.Id"
                                                    data-price="@product.Price"
                                                    data-stock="@product.Stock">
                                                @product.ProductName - Stock: @product.Stock
                                            </option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label">
                                        Quantity
                                    </label>
                                    <input type="number"
                                           class="form-control quantity-input"
                                           value="1"
                                           min="1" />
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label">
                                        Unit Price
                                    </label>
                                    <input type="number"
                                           class="form-control unit-price-input"
                                           step="0.01"
                                           readonly />
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label">
                                        Total
                                    </label>
                                    <input type="number"
                                           class="form-control total-price-input"
                                           step="0.01"
                                           readonly />
                                </div>
                                <div class="col-md-1">
                                    <button type="button"
                                            class="btn btn-danger remove-product">
                                        X
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
                <div class="row justify-content-end">
                    <div class="col-md-4">
                        <label class="form-label fw-bold">
                            Grand Total
                        </label>
                        <input type="text"
                               id="grandTotal"
                               class="form-control form-control-lg fw-bold"
                               value="0.00"
                               readonly />
                    </div>
                </div>
                <input type="hidden"
                       asp-for="TotalAmount"
                       id="totalAmount" />
                <hr />
                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index"
                       class="btn btn-secondary">
                        Cancel
                    </a>
                    <button type="submit"
                            class="btn btn-success">
                        @(Model.Id == 0 ? "Save Invoice" : "Update Invoice")
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const productForms = document.getElementById("productForms");
        document.getElementById("addProduct").addEventListener("click", function () {
            const firstForm = document.querySelector(".product-form");
            const newForm = firstForm.cloneNode(true);
            const productSelect = newForm.querySelector(".product-select");
            productSelect.value = "";
            const quantityInput = newForm.querySelector(".quantity-input");
            quantityInput.value = 1;
            const unitPriceInput = newForm.querySelector(".unit-price-input");
            unitPriceInput.value = "";
            const totalPriceInput = newForm.querySelector(".total-price-input");
            totalPriceInput.value = "";
            productSelect.classList.remove("is-invalid");
            quantityInput.classList.remove("is-invalid");
            const oldError = newForm.querySelector(".stock-error");
            if (oldError) {
                oldError.remove();
            }
            productForms.appendChild(newForm);
            calculateGrandTotal();
        });
        productForms.addEventListener("change", function (event) {
            if (event.target.classList.contains("product-select")) {
                const select = event.target;
                const selectedOption = select.options[select.selectedIndex];
                const price = selectedOption.getAttribute("data-price");
                const form = select.closest(".product-form");
                const unitPrice = form.querySelector(".unit-price-input");
                const quantity = form.querySelector(".quantity-input");
                unitPrice.value = price || "";
                quantity.value = 1;
                removeStockError(form);
                select.classList.remove("is-invalid");
                quantity.classList.remove("is-invalid");
                checkStock(form);
                calculateFormTotal(form);
            }
        });
        productForms.addEventListener("input", function (event) {
            if (event.target.classList.contains("quantity-input")) {
                const form = event.target.closest(".product-form");
                checkStock(form);
                calculateFormTotal(form);
            }
        });
        productForms.addEventListener("click", function (event) {
            if (event.target.classList.contains("remove-product")) {
                const forms = document.querySelectorAll(".product-form");
                if (forms.length === 1) {
                    alert("At least one product is required.");
                    return;
                }
                const form = event.target.closest(".product-form");
                form.remove();
                checkAllProductsStock();
                calculateGrandTotal();
            }
        });
        function checkStock(form) {
            const productSelect = form.querySelector(".product-select");
            const quantityInput = form.querySelector(".quantity-input");
            const selectedOption = productSelect.options[productSelect.selectedIndex];
            if (!productSelect.value || !selectedOption) {
                removeStockError(form);
                quantityInput.classList.remove("is-invalid");
                return true;
            }
            const stock = parseInt(selectedOption.getAttribute("data-stock")) || 0;
            const quantity = parseInt(quantityInput.value) || 0;
            if (quantity > stock) {
                showStockError(
                    form,
                    `Only ${stock} item(s) available in stock.`
                );
                quantityInput.classList.add("is-invalid");
                return false;
            }
            const productId = productSelect.value;
            let totalQuantity = 0;
            document.querySelectorAll(".product-form")
                .forEach(function (otherForm) {
                    const otherSelect =
                        otherForm.querySelector(".product-select");
                    const otherQuantity =
                        otherForm.querySelector(".quantity-input");
                    if (otherSelect.value === productId) {
                        totalQuantity +=
                            parseInt(otherQuantity.value) || 0;
                    }
                });
            if (totalQuantity > stock) {
                showStockError(
                    form,
                    `Total quantity for this product is ${totalQuantity}, but only ${stock} item(s) are available.`
                );
                quantityInput.classList.add("is-invalid");
                return false;
            }
            removeStockError(form);
            quantityInput.classList.remove("is-invalid");
            return true;
        }
        function checkAllProductsStock() {
            let valid = true;
            document.querySelectorAll(".product-form")
                .forEach(function (form) {
                    const result = checkStock(form);
                    if (!result) {
                        valid = false;
                    }
                });
            return valid;
        }
        function showStockError(form, message) {
            removeStockError(form);
            const error = document.createElement("div");
            error.className = "stock-error text-danger mt-2";
            error.innerHTML = `<strong>${message}</strong>`;
            form.appendChild(error);
        }
        function removeStockError(form) {
            const error = form.querySelector(".stock-error");
            if (error) {
                error.remove();
            }
        }
        function calculateFormTotal(form) {
            const quantity =
                parseFloat(
                    form.querySelector(".quantity-input").value
                ) || 0;
            const unitPrice =
                parseFloat(
                    form.querySelector(".unit-price-input").value
                ) || 0;
            const total = quantity * unitPrice;
            form.querySelector(".total-price-input").value =
                total.toFixed(2);
            calculateGrandTotal();
        }
        function calculateGrandTotal() {
            let grandTotal = 0;
            const forms = document.querySelectorAll(".product-form");
            forms.forEach(function (form) {
                const quantity =
                    parseFloat(
                        form.querySelector(".quantity-input").value
                    ) || 0;
                const unitPrice =
                    parseFloat(
                        form.querySelector(".unit-price-input").value
                    ) || 0;
                grandTotal += quantity * unitPrice;
            });
            document.getElementById("grandTotal").value =
                grandTotal.toFixed(2);
            document.getElementById("totalAmount").value =
                grandTotal.toFixed(2);
        }
        document.getElementById("saleForm").addEventListener("submit", function (event) {
            const stockValid = checkAllProductsStock();
            if (!stockValid) {
                event.preventDefault();
                alert("One or more products do not have enough stock.");
                return;
            }
            const forms = document.querySelectorAll(".product-form");
            document.querySelectorAll(".sale-detail-hidden")
                .forEach(function (input) {
                    input.remove();
                });
            let index = 0;
            let valid = true;
            forms.forEach(function (form) {
                const productSelect =
                    form.querySelector(".product-select");
                const quantityInput =
                    form.querySelector(".quantity-input");
                const unitPriceInput =
                    form.querySelector(".unit-price-input");
                const totalPriceInput =
                    form.querySelector(".total-price-input");
                const productId = productSelect.value;
                const quantity =
                    parseInt(quantityInput.value) || 0;
                const unitPrice =
                    parseFloat(unitPriceInput.value) || 0;
                const totalPrice = quantity * unitPrice;
                if (!productId) {
                    valid = false;
                    productSelect.classList.add("is-invalid");
                }
                else {
                    productSelect.classList.remove("is-invalid");
                }
                if (quantity <= 0) {
                    valid = false;
                    quantityInput.classList.add("is-invalid");
                }
                else {
                    quantityInput.classList.remove("is-invalid");
                }
                if (unitPrice <= 0) {
                    valid = false;
                }
                totalPriceInput.value = totalPrice.toFixed(2);
                addHiddenInput(
                    `SaleDetails[${index}].ProductId`,
                    productId
                );
                addHiddenInput(
                    `SaleDetails[${index}].Quantity`,
                    quantity
                );
                addHiddenInput(
                    `SaleDetails[${index}].UnitPrice`,
                    unitPrice.toFixed(2)
                );
                addHiddenInput(
                    `SaleDetails[${index}].TotalPrice`,
                    totalPrice.toFixed(2)
                );
                index++;
            });
            if (forms.length === 0) {
                valid = false;
                alert("Please add at least one product.");
            }
            if (!valid) {
                event.preventDefault();
                alert("Please select product and enter valid quantity.");
                return;
            }
            calculateGrandTotal();
        });
        function addHiddenInput(name, value) {
            const input = document.createElement("input");
            input.type = "hidden";
            input.name = name;
            input.value = value;
            input.classList.add("sale-detail-hidden");
            document.getElementById("saleForm")
                .appendChild(input);
        }
        document.querySelectorAll(".product-form")
            .forEach(function (form) {
                calculateFormTotal(form);
                checkStock(form);
            });
        checkAllProductsStock();
    </script>
}
@model SalesInvoiceSystem.Models.Sale

@{
    bool isEdit = Model.Id != 0;

    ViewData["Title"] = isEdit
        ? "Edit Sale"
        : "Create Sale";

    var products = ViewBag.Products
        as IEnumerable<SalesInvoiceSystem.Models.Product>;

    var customers = ViewBag.Customers
        as IEnumerable<SalesInvoiceSystem.Models.Customer>;
}

<div class="container mt-4">

    <div class="row justify-content-center">

        <div class="col-md-8">

            <div class="card shadow">

                <!-- ================================= -->
                <!-- HEADER -->
                <!-- ================================= -->

                <div class="card-header bg-primary text-white">

                    <h3 class="mb-0">

                        @(isEdit
                                                ? "Edit Sale"
                                                : "Create Sale")

                    </h3>

                </div>


                <!-- ================================= -->
                <!-- BODY -->
                <!-- ================================= -->

                <div class="card-body">

                    <form asp-controller="Sale"
                          asp-action="CreateOrEdit"
                          method="post">

                        @Html.AntiForgeryToken()


                        <!-- ================================= -->
                        <!-- SALE ID -->
                        <!-- ================================= -->

                        <input type="hidden"
                               asp-for="Id" />


                        <!-- ================================= -->
                        <!-- VALIDATION -->
                        <!-- ================================= -->

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>


                        <!-- ================================= -->
                        <!-- INVOICE NO -->
                        <!-- ================================= -->

                        <div class="mb-3">

                            <label asp-for="InvoiceNo"
                                   class="form-label">

                                Invoice No

                            </label>

                            <input asp-for="InvoiceNo"
                                   class="form-control"
                                   readonly />

                            <span asp-validation-for="InvoiceNo"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- ================================= -->
                        <!-- CUSTOMER DROPDOWN -->
                        <!-- ================================= -->

                        <div class="mb-3">

                            <label asp-for="CustomerId"
                                   class="form-label">

                                Customer

                            </label>


                            <select asp-for="CustomerId"
                                    class="form-select">

                                <option value="">
                                    -- Select Customer --
                                </option>


                                @if (customers != null)
                                {
                                    foreach (var customer in customers)
                                    {
                                        <option value="@customer.Id">

                                            @customer.Id
                                            -
                                            @customer.CustomerName

                                        </option>
                                    }
                                }

                            </select>


                            <span asp-validation-for="CustomerId"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- ================================= -->
                        <!-- PRODUCT DROPDOWN -->
                        <!-- ================================= -->

                        <div class="mb-3">

                            <label class="form-label">

                                Product

                            </label>


                            <select id="ProductId"
                                    name="ProductId"
                                    class="form-select">

                                <option value="">
                                    -- Select Product --
                                </option>


                                @if (products != null)
                                {
                                    foreach (var product in products)
                                    {
                                        <option value="@product.Id">

                                            @product.Id
                                            -
                                            @product.ProductName

                                        </option>
                                    }
                                }

                            </select>

                        </div>


                        <!-- ================================= -->
                        <!-- SALE DATE -->
                        <!-- ================================= -->

                        <div class="mb-3">

                            <label asp-for="SaleDate"
                                   class="form-label">

                                Sale Date

                            </label>


                            <input asp-for="SaleDate"
                                   type="datetime-local"
                                   class="form-control" />


                            <span asp-validation-for="SaleDate"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- ================================= -->
                        <!-- TOTAL AMOUNT -->
                        <!-- ================================= -->

                        <div class="mb-3">

                            <label asp-for="TotalAmount"
                                   class="form-label">

                                Total Amount

                            </label>


                            <input asp-for="TotalAmount"
                                   type="number"
                                   step="0.01"
                                   min="0"
                                   class="form-control"
                                   placeholder="0.00" />


                            <span asp-validation-for="TotalAmount"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- ================================= -->
                        <!-- BUTTONS -->
                        <!-- ================================= -->

                        <div class="mt-4">

                            <button type="submit"
                                    class="btn btn-success">

                                @(isEdit
                                                                ? "Update Sale"
                                                                : "Create Sale")

                            </button>


                            <a asp-controller="Sale"
                               asp-action="Index"
                               class="btn btn-secondary">

                                Back to List

                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>


@section Scripts
{
    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial");
    }
}
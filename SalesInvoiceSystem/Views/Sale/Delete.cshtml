@model SalesInvoiceSystem.Models.Sale

@{
    ViewData["Title"] = "Delete Sale";
}

<div class="row">
    <div class="col-md-7">

        <div class="card border-danger">

            <div class="card-header bg-danger text-white">
                <h3 class="mb-0">Delete Sale</h3>
            </div>

            <div class="card-body">

                <div class="alert alert-warning">
                    <strong>Warning!</strong>
                    Are you sure you want to delete this invoice?
                </div>

                <dl class="row">

                    <dt class="col-sm-4">
                        Invoice No
                    </dt>
                    <dd class="col-sm-8">
                        @Model.InvoiceNo
                    </dd>

                    <dt class="col-sm-4">
                        Customer ID
                    </dt>
                    <dd class="col-sm-8">
                        @Model.CustomerId
                    </dd>

                    <dt class="col-sm-4">
                        Sale Date
                    </dt>
                    <dd class="col-sm-8">
                        @Model.SaleDate.ToString("dd-MM-yyyy hh:mm tt")
                    </dd>

                    <dt class="col-sm-4">
                        Total Amount
                    </dt>
                    <dd class="col-sm-8">
                        @Model.TotalAmount.ToString("N2")
                    </dd>

                </dl>

                <form asp-controller="Sale"
                      asp-action="DeleteConfirmed"
                      method="post">

                    @Html.AntiForgeryToken()

                    <input type="hidden" name="id" value="@Model.Id" />

                    <button type="submit"
                            class="btn btn-danger">
                        <i class="bi bi-trash"></i>
                        Yes, Delete
                    </button>

                    <a asp-controller="Sale"
                       asp-action="Index"
                       class="btn btn-secondary">
                        Cancel
                    </a>

                </form>

            </div>
        </div>

    </div>
</div>
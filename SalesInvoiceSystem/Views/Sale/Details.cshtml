@model SalesInvoiceSystem.Models.Sale

@{
    ViewData["Title"] = "Sale Details";
}

<div class="card">

    <div class="card-header">
        <h3>Sale Details</h3>
    </div>

    <div class="card-body">

        <dl class="row">

            <dt class="col-sm-3">
                Invoice No
            </dt>

            <dd class="col-sm-9">
                @Model.InvoiceNo
            </dd>


            <dt class="col-sm-3">
                Customer ID
            </dt>

            <dd class="col-sm-9">
                @Model.CustomerId
            </dd>


            <dt class="col-sm-3">
                Sale Date
            </dt>

            <dd class="col-sm-9">
                @Model.SaleDate.ToString("dd-MM-yyyy hh:mm tt")
            </dd>


            <dt class="col-sm-3">
                Total Amount
            </dt>

            <dd class="col-sm-9">
                @Model.TotalAmount.ToString("N2")
            </dd>

        </dl>


        <div class="mt-3">

            <a asp-controller="Sale"
               asp-action="CreateOrEdit"
               asp-route-id="@Model.Id"
               class="btn btn-warning">
                Edit
            </a>

            <a asp-controller="Sale"
               asp-action="Index"
               class="btn btn-secondary">
                Back to List
            </a>

        </div>

    </div>

</div>
@model SalesInvoiceSystem.Models.Sale

@{
    ViewData["Title"] = "Sale Details";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">

        <h3>Invoice Details</h3>

        <div>

            <a asp-action="Index"
               class="btn btn-secondary">
                Back
            </a>

            <a asp-action="CreateOrEdit"
               asp-route-id="@Model.Id"
               class="btn btn-warning">
                Edit
            </a>

            <a asp-action="Invoice"
               asp-route-id="@Model.Id"
               class="btn btn-primary"
               target="_blank">
                Print Invoice
            </a>

        </div>

    </div>


    <div class="card shadow-sm mb-4">

        <div class="card-header">
            <strong>Invoice Information</strong>
        </div>

        <div class="card-body">

            <div class="row">

                <div class="col-md-3">
                    <strong>Invoice No</strong>
                    <div>
                        @Model.InvoiceNo
                    </div>
                </div>

                <div class="col-md-3">
                    <strong>Customer</strong>
                    <div>
                        @Model.Customer.CustomerName
                    </div>
                </div>

                <div class="col-md-3">
                    <strong>Sale Date</strong>
                    <div>
                        @Model.SaleDate.ToString("dd MMM yyyy hh:mm tt")
                    </div>
                </div>

                <div class="col-md-3">
                    <strong>Total Amount</strong>
                    <div>
                        @Model.TotalAmount.ToString("N2")
                    </div>
                </div>

            </div>

        </div>

    </div>


    <div class="card shadow-sm">

        <div class="card-header">
            <strong>Products</strong>
        </div>

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-bordered">

                    <thead class="table-dark">

                        <tr>
                            <th>#</th>
                            <th>Product</th>
                            <th>Quantity</th>
                            <th>Unit Price</th>
                            <th>Total Price</th>
                        </tr>

                    </thead>

                    <tbody>

                        @if (Model.SaleDetails != null &&
                                                Model.SaleDetails.Any())
                        {
                            int count = 1;

                            foreach (var item in Model.SaleDetails)
                            {
                                <tr>

                                    <td>
                                        @count
                                    </td>

                                    <td>
                                        @item.Product.ProductName
                                    </td>

                                    <td>
                                        @item.Quantity
                                    </td>

                                    <td>
                                        @item.UnitPrice.ToString("N2")
                                    </td>

                                    <td>
                                        @item.TotalPrice.ToString("N2")
                                    </td>

                                </tr>

                                count++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5"
                                    class="text-center">
                                    No products found.
                                </td>
                            </tr>
                        }

                    </tbody>

                    <tfoot>

                        <tr>

                            <th colspan="4"
                                class="text-end">
                                Grand Total
                            </th>

                            <th>
                                @Model.TotalAmount.ToString("N2")
                            </th>

                        </tr>

                    </tfoot>

                </table>

            </div>

        </div>

    </div>

</div>
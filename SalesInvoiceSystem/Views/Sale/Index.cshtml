
@model IEnumerable<SalesInvoiceSystem.Models.Sale>

@{
    Layout = "_Layout";
    ViewData["Title"] = "Sales";
}

<div class="container mt-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3>
            <i class="bi bi-receipt me-2"></i>
            Sales / Invoices
        </h3>

        <a asp-controller="Sale"
           asp-action="CreateOrEdit"
           class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i>
            Create Invoice
        </a>
    </div>

    <!-- Success Message -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="bi bi-check-circle me-2"></i>
            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    <!-- Error Message -->
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="bi bi-exclamation-triangle me-2"></i>
            @TempData["ErrorMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }


    <!-- Search / Filter Section -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">

            <div class="row g-3 align-items-center">

                <!-- Search -->
                <div class="col-md-6">
                    <div class="input-group">

                        <span class="input-group-text">
                            <i class="bi bi-search"></i>
                        </span>

                        <input type="text"
                               id="saleSearch"
                               class="form-control"
                               placeholder="Search invoice, customer, date or amount..."
                               autocomplete="off" />

                    </div>
                </div>


                <!-- Date Filter -->
                <div class="col-md-3">

                    <input type="date"
                           id="dateFilter"
                           class="form-control" />

                </div>


                <!-- Reset -->
                <div class="col-md-3">

                    <button type="button"
                            id="resetSearch"
                            class="btn btn-secondary w-100">

                        <i class="bi bi-arrow-clockwise me-1"></i>
                        Reset

                    </button>

                </div>

            </div>

        </div>
    </div>


    <!-- Sales Table -->
    <div class="card shadow-sm">

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-bordered table-hover align-middle"
                       id="salesTable">

                    <thead class="table-dark">

                        <tr>

                            <th>#</th>

                            <th>Invoice No</th>

                            <th>Customer</th>

                            <th>Sale Date</th>

                            <th class="text-end">
                                Total Amount
                            </th>

                            <th style="width: 220px;">
                                Action
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            int count = 1;

                            foreach (var sale in Model)
                            {
                                <tr class="sale-row"
                                    data-date="@sale.SaleDate.ToString("yyyy-MM-dd")">

                                    <td>
                                        @count
                                    </td>

                                    <td>
                                        <strong>
                                            @sale.InvoiceNo
                                        </strong>
                                    </td>

                                    <td>
                                        @(sale.Customer?.CustomerName ?? "N/A")
                                    </td>

                                    <td>
                                        @sale.SaleDate.ToString("dd MMM yyyy hh:mm tt")
                                    </td>

                                    <td class="text-end">
                                        @sale.TotalAmount.ToString("N2")
                                    </td>

                                    <td>

                                        <a asp-action="Details"
                                           asp-route-id="@sale.Id"
                                           class="btn btn-sm btn-info">

                                            <i class="bi bi-eye"></i>
                                            Details

                                        </a>


                                        <a asp-action="CreateOrEdit"
                                           asp-route-id="@sale.Id"
                                           class="btn btn-sm btn-warning">

                                            <i class="bi bi-pencil"></i>
                                            Edit

                                        </a>


                                        <a asp-action="Delete"
                                           asp-route-id="@sale.Id"
                                           class="btn btn-sm btn-danger">

                                            <i class="bi bi-trash"></i>
                                            Delete

                                        </a>

                                    </td>

                                </tr>

                                count++;
                            }
                        }
                        else
                        {
                            <tr id="noSalesRow">

                                <td colspan="6"
                                    class="text-center text-muted py-4">

                                    <i class="bi bi-inbox fs-3 d-block mb-2"></i>

                                    No sales found.

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>


            <!-- Search Result Message -->

            <div id="searchResult"
                 class="text-muted mt-3"
                 style="display:none;">
            </div>

        </div>

    </div>

</div>


@section Styles {

    <style>

        .input-group-text {
            background: #f8fafc;
            border-right: none;
        }

        #saleSearch {
            border-left: none;
        }

            #saleSearch:focus {
                box-shadow: none;
                border-color: #dee2e6;
            }

        .sale-row {
            transition: background-color .2s;
        }

            .sale-row:hover {
                background-color: #f8fafc;
            }

    </style>

}


@section Scripts {

    <script>

        document.addEventListener("DOMContentLoaded", function () {

            const searchInput =
                document.getElementById("saleSearch");

            const dateFilter =
                document.getElementById("dateFilter");

            const resetButton =
                document.getElementById("resetSearch");

            const resultMessage =
                document.getElementById("searchResult");

            const rows =
                document.querySelectorAll(".sale-row");


            function filterSales() {

                const searchText =
                    searchInput.value
                        .toLowerCase()
                        .trim();

                const selectedDate =
                    dateFilter.value;

                let visibleCount = 0;


                rows.forEach(function (row) {

                    /*
                     * Get complete row text
                     *
                     * This includes:
                     * Invoice No
                     * Customer
                     * Sale Date
                     * Total Amount
                     */

                    const rowText =
                        row.innerText
                            .toLowerCase();


                    const rowDate =
                        row.dataset.date;


                    // Search match
                    const searchMatch =
                        searchText === "" ||
                        rowText.includes(searchText);


                    // Date match
                    const dateMatch =
                        selectedDate === "" ||
                        rowDate === selectedDate;


                    // Final result
                    if (searchMatch && dateMatch) {

                        row.style.display = "";

                        visibleCount++;

                    }
                    else {

                        row.style.display = "none";

                    }

                });


                // Show result count

                if (searchText !== "" || selectedDate !== "") {

                    resultMessage.style.display = "block";

                    resultMessage.innerHTML =
                        `<i class="bi bi-info-circle me-1"></i>
                         ${visibleCount} invoice(s) found.`;

                }
                else {

                    resultMessage.style.display = "none";

                }

            }


            // Search while typing

            searchInput.addEventListener(
                "input",
                filterSales
            );


            // Date filter

            dateFilter.addEventListener(
                "change",
                filterSales
            );


            // Reset

            resetButton.addEventListener(
                "click",
                function () {

                    searchInput.value = "";

                    dateFilter.value = "";

                    rows.forEach(function (row) {

                        row.style.display = "";

                    });

                    resultMessage.style.display = "none";

                }
            );

        });

    </script>

}


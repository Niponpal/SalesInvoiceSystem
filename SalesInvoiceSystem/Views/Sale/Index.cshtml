@model IEnumerable<SalesInvoiceSystem.Models.Sale>

@{
    ViewData["Title"] = "Sales";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3>Sales / Invoices</h3>

        <a asp-controller="Sale"
           asp-action="CreateOrEdit"
           class="btn btn-primary">
            <i class="bi bi-plus-circle"></i>
            Create Invoice
        </a>
    </div>


    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }


    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["ErrorMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }


    <div class="card shadow-sm">

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-bordered table-hover align-middle">

                    <thead class="table-dark">

                        <tr>
                            <th>#</th>
                            <th>Invoice No</th>
                            <th>Customer</th>
                            <th>Sale Date</th>
                            <th class="text-end">Total Amount</th>
                            <th style="width: 220px;">Action</th>
                        </tr>

                    </thead>

                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            int count = 1;

                            foreach (var sale in Model)
                            {
                                <tr>

                                    <td>@count</td>

                                    <td>
                                        <strong>
                                            @sale.InvoiceNo
                                        </strong>
                                    </td>

                                    <td>
                                        @sale.Customer?.CustomerName
                                    </td>

                                    <td>
                                        @sale.SaleDate.ToString("dd MMM yyyy hh:mm tt")
                                    </td>

                                    <td class="text-end">
                                        @sale.TotalAmount.ToString("N2")
                                    </td>

                                    <td>

                                        <a asp-action="Details"
                                           asp-route-id="@sale.Id"
                                           class="btn btn-sm btn-info">
                                            Details
                                        </a>

                                        <a asp-action="CreateOrEdit"
                                           asp-route-id="@sale.Id"
                                           class="btn btn-sm btn-warning">
                                            Edit
                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-id="@sale.Id"
                                           class="btn btn-sm btn-danger">
                                            Delete
                                        </a>

                                    </td>

                                </tr>

                                count++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6"
                                    class="text-center text-muted py-4">
                                    No sales found.
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>
@{
    ViewData["Title"] = "Sales Dashboard";
}

@section Styles {
    <style>
        /* Filter Section */
        .filter-section {
            background: var(--card-bg);
            border-radius: var(--radius-lg);
            padding: 1rem 1.5rem;
            box-shadow: var(--shadow-sm);
            display: flex;
            align-items: center;
            gap: 1rem;
            flex-wrap: wrap;
            border: 1px solid var(--border);
        }

        .filter-label {
            font-weight: 600;
            color: var(--text-primary);
            white-space: nowrap;
        }

        .filter-select {
            width: auto;
            min-width: 160px;
            border: none;
            background: #f1f5f9;
            padding: .65rem 1rem;
            border-radius: 2rem;
            font-weight: 500;
        }

        .search-box {
            position: relative;
            min-width: 260px;
            flex: 1;
            max-width: 340px;
        }

            .search-box input {
                width: 100%;
                border: none;
                background: #f1f5f9;
                padding: .65rem 1rem .65rem 2.6rem;
                border-radius: 2rem;
                font-weight: 500;
            }

            .search-box i {
                position: absolute;
                left: 1rem;
                top: 50%;
                transform: translateY(-50%);
                color: #64748b;
            }

        .btn-apply {
            background: var(--primary);
            border: none;
            padding: .65rem 1.5rem;
            border-radius: 2rem;
            font-weight: 600;
            color: white;
        }

            .btn-apply:hover {
                background: var(--primary-dark);
            }

        /* Cards */
        .stat-card {
            background: var(--card-bg);
            border-radius: var(--radius-lg);
            box-shadow: var(--shadow-md);
            padding: 1.8rem 1.5rem;
            border: 1px solid var(--border);
            transition: .3s;
        }

            .stat-card:hover {
                transform: translateY(-6px);
                box-shadow: 0 20px 40px rgba(0,0,0,.10);
            }

        .stat-value {
            font-size: 2rem;
            font-weight: 800;
            line-height: 1;
        }

        .stat-label {
            color: var(--text-secondary);
            font-weight: 600;
            font-size: .85rem;
            text-transform: uppercase;
            letter-spacing: .04em;
        }

        .stat-icon {
            font-size: 2.7rem;
            opacity: .85;
        }

        .chart-card {
            background: var(--card-bg);
            border-radius: var(--radius-lg);
            box-shadow: var(--shadow-md);
            padding: 1.8rem;
            border: 1px solid var(--border);
            height: 100%;
        }

        .chart-title {
            font-weight: 700;
        }

        .quick-card {
            background: var(--card-bg);
            border: 1px solid var(--border);
            border-radius: var(--radius-lg);
            box-shadow: var(--shadow-sm);
            padding: 1.4rem;
            display: flex;
            align-items: center;
            gap: 1rem;
            transition: .3s;
        }

            .quick-card:hover {
                transform: translateY(-5px);
                box-shadow: var(--shadow-md);
            }

            .quick-card i {
                font-size: 2.2rem;
            }

            .quick-card h6 {
                color: var(--text-primary);
                margin-bottom: .25rem;
            }

            .quick-card small {
                color: var(--text-secondary);
            }

        .recent-reg-table {
            background: var(--card-bg);
            border-radius: var(--radius-lg);
            box-shadow: var(--shadow-md);
            overflow: hidden;
            border: 1px solid var(--border);
        }

            .recent-reg-table .table th {
                background: #f8fafc;
                font-weight: 700;
                font-size: .8rem;
                text-transform: uppercase;
                letter-spacing: .04em;
                color: var(--text-secondary);
                border-bottom: 2px solid var(--border);
            }

            .recent-reg-table .table td {
                vertical-align: middle;
            }

        .table-hover tbody tr:hover {
            background: rgba(59,130,246,.04);
        }

        @@media (max-width: 992px) {
            .filter-section {
                width: 100%;
                align-items: stretch;
            }

            .filter-select, .search-box {
                width: 100%;
                max-width: 100%;
            }

            .btn-apply {
                width: 100%;
            }

            .stat-value {
                font-size: 1.7rem;
            }
        }
    </style>
}

<div class="container-fluid px-0">

    <!-- Dashboard Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-1">
                <i class="bi bi-speedometer2 me-2"></i>
                Sales Dashboard
            </h3>
            <p class="text-muted mb-0">Sales Invoice Management System</p>
        </div>
    </div>

    <!-- Filter + Search Section -->
    <div class="filter-section mb-5">
        <span class="filter-label">
            <i class="bi bi-funnel me-1"></i> Filter & Search:
        </span>

        <div class="search-box">
            <i class="bi bi-search"></i>
            <input type="text" id="searchInput" class="form-control"
                   placeholder="Search customer, product, invoice no or date..." autocomplete="off" />
        </div>

        <select class="filter-select form-select" id="customerFilter" title="Filter by Customer Name">
            <option value="all">All Customers</option>
            <option value="rahim">Rahim Ahmed</option>
            <option value="karim">Karim Hasan</option>
            <option value="sumaiya">Sumaiya Akter</option>
            <option value="hasan">Hasan Mahmud</option>
            <option value="jannatul">Jannatul Ferdous</option>
        </select>

        <select class="filter-select form-select" id="productFilter" title="Filter by Product Name">
            <option value="all">All Products</option>
            <option value="laptop">Laptop</option>
            <option value="keyboard">Keyboard</option>
            <option value="mouse">Mouse</option>
            <option value="monitor">Monitor</option>
            <option value="printer">Printer</option>
        </select>

        <input type="date" id="dateFilter" class="filter-select form-control" title="Filter by Date" />

        <button type="button" id="applyFilter" class="btn-apply">
            <i class="bi bi-search me-1"></i> Apply
        </button>
        <button type="button" id="clearFilter" class="btn btn-secondary">
            <i class="bi bi-arrow-clockwise me-1"></i> Reset
        </button>
    </div>

    <!-- Statistics Cards -->
    <div class="row g-4 mb-5">
        <div class="col-sm-6 col-lg-3">
            <div class="stat-card d-flex align-items-center">
                <i class="bi bi-people stat-icon me-3 text-primary"></i>
                <div>
                    <div class="stat-label">Total Customers</div>
                    <div class="stat-value">125</div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="stat-card d-flex align-items-center">
                <i class="bi bi-box-seam stat-icon me-3 text-success"></i>
                <div>
                    <div class="stat-label">Total Products</div>
                    <div class="stat-value">250</div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="stat-card d-flex align-items-center">
                <i class="bi bi-receipt stat-icon me-3 text-warning"></i>
                <div>
                    <div class="stat-label">Total Invoices</div>
                    <div class="stat-value">180</div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="stat-card d-flex align-items-center">
                <i class="bi bi-cash-stack stat-icon me-3 text-info"></i>
                <div>
                    <div class="stat-label">Total Sales</div>
                    <div class="stat-value">৳ 125,500</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Charts -->
    <div class="row g-4 mb-5">
        <div class="col-md-6">
            <div class="chart-card">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div>
                        <h5 class="chart-title mb-0">Daily Sales</h5>
                        <small class="text-muted">Last 10 days</small>
                    </div>
                    <i class="bi bi-graph-up-arrow fs-4 text-primary opacity-75"></i>
                </div>
                <div class="d-flex align-items-end gap-2 mt-4" style="height:160px;">
                    <div class="bg-primary rounded-top" style="width:9%; height:45%;" title="৳ 12,000"></div>
                    <div class="bg-primary rounded-top" style="width:9%; height:60%;" title="৳ 18,000"></div>
                    <div class="bg-primary rounded-top" style="width:9%; height:35%;" title="৳ 10,000"></div>
                    <div class="bg-primary rounded-top" style="width:9%; height:75%;" title="৳ 25,000"></div>
                    <div class="bg-primary rounded-top" style="width:9%; height:90%;" title="৳ 32,000"></div>
                    <div class="bg-primary rounded-top" style="width:9%; height:55%;" title="৳ 17,000"></div>
                    <div class="bg-primary rounded-top" style="width:9%; height:70%;" title="৳ 22,000"></div>
                    <div class="bg-primary rounded-top" style="width:9%; height:40%;" title="৳ 13,000"></div>
                    <div class="bg-primary rounded-top" style="width:9%; height:80%;" title="৳ 28,000"></div>
                    <div class="bg-primary rounded-top" style="width:9%; height:65%;" title="৳ 20,000"></div>
                </div>
                <div class="d-flex justify-content-between mt-2 small text-muted">
                    <span>Day 1</span>
                    <span>Day 5</span>
                    <span>Day 10</span>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="chart-card">
                <h5 class="chart-title mb-1">Payment Status</h5>
                <small class="text-muted d-block mb-4">Invoice payment overview</small>
                <div class="d-flex justify-content-between mb-2">
                    <span class="fw-semibold">Paid</span>
                    <span class="text-success fw-bold">85.7%</span>
                </div>
                <div class="progress rounded-pill mb-4" style="height:14px;">
                    <div class="progress-bar bg-success" style="width:85.7%;"></div>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="fw-semibold">Pending</span>
                    <span class="text-warning fw-bold">9.3%</span>
                </div>
                <div class="progress rounded-pill mb-4" style="height:14px;">
                    <div class="progress-bar bg-warning" style="width:9.3%;"></div>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="fw-semibold">Unpaid</span>
                    <span class="text-danger fw-bold">5%</span>
                </div>
                <div class="progress rounded-pill" style="height:14px;">
                    <div class="progress-bar bg-danger" style="width:5%;"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="row g-4 mb-5">
        <div class="col-md-4">
            <a asp-controller="Sale" asp-action="CreateOrEdit" class="text-decoration-none">
                <div class="quick-card">
                    <i class="bi bi-receipt text-primary"></i>
                    <div>
                        <h6>Create Invoice</h6>
                        <small>Create a new sales invoice</small>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-md-4">
            <a asp-controller="Customer" asp-action="Index" class="text-decoration-none">
                <div class="quick-card">
                    <i class="bi bi-person-plus text-success"></i>
                    <div>
                        <h6>Customers</h6>
                        <small>Manage your customers</small>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-md-4">
            <a asp-controller="Product" asp-action="Index" class="text-decoration-none">
                <div class="quick-card">
                    <i class="bi bi-box-seam text-warning"></i>
                    <div>
                        <h6>Products</h6>
                        <small>Manage products and stock</small>
                    </div>
                </div>
            </a>
        </div>
    </div>

    <!-- Recent Invoices Table -->
    <div class="recent-reg-table mb-5">
        <h5 class="fw-semibold mb-3 px-4 pt-4">
            <i class="bi bi-list-ul me-2"></i> Recent Invoices
        </h5>
        <div class="table-responsive px-4 pb-4">
            <table class="table table-hover mb-0" id="invoiceTable">
                <thead>
                    <tr>
                        <th>Invoice No</th>
                        <th>Customer</th>
                        <th>Product</th>
                        <th>Amount</th>
                        <th>Payment Status</th>
                        <th>Date</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    <tr data-customer="rahim" data-product="laptop" data-date="2026-09-04">
                        <td><strong>INV-20260904001</strong></td>
                        <td>Rahim Ahmed</td>
                        <td>Laptop</td>
                        <td>৳ 65,000.00</td>
                        <td><span class="badge bg-success-subtle text-success">Paid</span></td>
                        <td>04 Sep 2026</td>
                        <td>
                            <a asp-controller="Sale" asp-action="Details" asp-route-id="1" class="btn btn-sm btn-info">
                                <i class="bi bi-eye"></i>
                            </a>
                        </td>
                    </tr>
                    <tr data-customer="karim" data-product="keyboard" data-date="2026-09-03">
                        <td><strong>INV-20260904002</strong></td>
                        <td>Karim Hasan</td>
                        <td>Keyboard</td>
                        <td>৳ 3,500.00</td>
                        <td><span class="badge bg-warning-subtle text-warning">Pending</span></td>
                        <td>03 Sep 2026</td>
                        <td>
                            <a asp-controller="Sale" asp-action="Details" asp-route-id="2" class="btn btn-sm btn-info">
                                <i class="bi bi-eye"></i>
                            </a>
                        </td>
                    </tr>
                    <tr data-customer="sumaiya" data-product="mouse" data-date="2026-09-03">
                        <td><strong>INV-20260903003</strong></td>
                        <td>Sumaiya Akter</td>
                        <td>Mouse</td>
                        <td>৳ 1,200.00</td>
                        <td><span class="badge bg-danger-subtle text-danger">Unpaid</span></td>
                        <td>03 Sep 2026</td>
                        <td>
                            <a asp-controller="Sale" asp-action="Details" asp-route-id="3" class="btn btn-sm btn-info">
                                <i class="bi bi-eye"></i>
                            </a>
                        </td>
                    </tr>
                    <tr data-customer="hasan" data-product="monitor" data-date="2026-09-02">
                        <td><strong>INV-20260902004</strong></td>
                        <td>Hasan Mahmud</td>
                        <td>Monitor</td>
                        <td>৳ 25,000.00</td>
                        <td><span class="badge bg-success-subtle text-success">Paid</span></td>
                        <td>02 Sep 2026</td>
                        <td>
                            <a asp-controller="Sale" asp-action="Details" asp-route-id="4" class="btn btn-sm btn-info">
                                <i class="bi bi-eye"></i>
                            </a>
                        </td>
                    </tr>
                    <tr data-customer="jannatul" data-product="printer" data-date="2026-09-01">
                        <td><strong>INV-20260901005</strong></td>
                        <td>Jannatul Ferdous</td>
                        <td>Printer</td>
                        <td>৳ 18,500.00</td>
                        <td><span class="badge bg-success-subtle text-success">Paid</span></td>
                        <td>01 Sep 2026</td>
                        <td>
                            <a asp-controller="Sale" asp-action="Details" asp-route-id="5" class="btn btn-sm btn-info">
                                <i class="bi bi-eye"></i>
                            </a>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const searchInput    = document.getElementById("searchInput");
            const customerFilter = document.getElementById("customerFilter");
            const productFilter  = document.getElementById("productFilter");
            const dateFilter     = document.getElementById("dateFilter");
            const applyFilter    = document.getElementById("applyFilter");
            const clearFilter    = document.getElementById("clearFilter");
            const rows           = document.querySelectorAll("#invoiceTable tbody tr");

            function filterTable() {
                const searchText = (searchInput.value || "").toLowerCase().trim();
                const customer   = customerFilter.value;
                const product    = productFilter.value;
                const date       = dateFilter.value;

                rows.forEach(function (row) {
                    const rowCustomer = (row.dataset.customer || "").toLowerCase();
                    const rowProduct  = (row.dataset.product || "").toLowerCase();
                    const rowDate     = row.dataset.date || "";
                    const rowText     = row.innerText.toLowerCase();

                    const searchMatch   = searchText === "" || rowText.includes(searchText);
                    const customerMatch = customer === "all" || rowCustomer === customer.toLowerCase();
                    const productMatch  = product === "all"  || rowProduct === product.toLowerCase();
                    const dateMatch     = date === "" || rowDate === date;

                    row.style.display = (searchMatch && customerMatch && productMatch && dateMatch) ? "" : "none";
                });
            }

            if (searchInput) searchInput.addEventListener("input", filterTable);
            if (applyFilter) applyFilter.addEventListener("click", filterTable);

            if (clearFilter) {
                clearFilter.addEventListener("click", function () {
                    searchInput.value = "";
                    customerFilter.value = "all";
                    productFilter.value = "all";
                    dateFilter.value = "";
                    rows.forEach(row => row.style.display = "");
                });
            }

            customerFilter.addEventListener("change", filterTable);
            productFilter.addEventListener("change", filterTable);
            dateFilter.addEventListener("change", filterTable);
        });
    </script>
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sales Invoice System</title>

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />

    <style>
        :root {
            --primary: #3b82f6;
            --primary-dark: #2563eb;
            --card-bg: #ffffff;
            --border: #e2e8f0;
            --text-primary: #1e293b;
            --text-secondary: #64748b;
            --radius-lg: 1rem;
            --shadow-sm: 0 1px 3px rgba(0,0,0,.08);
            --shadow-md: 0 4px 12px rgba(0,0,0,.08);
            --body-bg: #f1f5f9;
            --sidebar-width: 260px;
            --sidebar-bg: #0f172a;
            --sidebar-hover: #1e293b;
        }

        body {
            background-color: var(--body-bg);
            color: var(--text-primary);
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            margin: 0;
            overflow-x: hidden;
        }

        /* ========== TOP HEADER ========== */
        .top-header {
            background: var(--card-bg);
            border-bottom: 1px solid var(--border);
            box-shadow: var(--shadow-sm);
            height: 64px;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 1030;
            display: flex;
            align-items: center;
            padding: 0 1.5rem;
        }

            .top-header .brand {
                font-weight: 700;
                font-size: 1.25rem;
                color: var(--primary);
                text-decoration: none;
                display: flex;
                align-items: center;
                gap: .5rem;
            }

                .top-header .brand:hover {
                    color: var(--primary-dark);
                }

        .header-right {
            margin-left: auto;
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .btn-create {
            background: var(--primary);
            color: white;
            border: none;
            padding: .45rem 1.1rem;
            border-radius: 2rem;
            font-weight: 600;
            font-size: .9rem;
        }

            .btn-create:hover {
                background: var(--primary-dark);
                color: white;
            }

        /* ========== LEFT SIDEBAR ========== */
        .sidebar {
            width: var(--sidebar-width);
            background: var(--sidebar-bg);
            position: fixed;
            top: 64px;
            left: 0;
            bottom: 0;
            z-index: 1020;
            overflow-y: auto;
            transition: transform .3s ease;
        }

        .sidebar-menu {
            list-style: none;
            padding: 1.25rem 0;
            margin: 0;
        }

            .sidebar-menu .nav-item {
                margin: 2px 12px;
            }

            .sidebar-menu .nav-link {
                display: flex;
                align-items: center;
                gap: .85rem;
                padding: .75rem 1rem;
                color: #94a3b8;
                text-decoration: none;
                border-radius: .75rem;
                font-weight: 500;
                font-size: .95rem;
                transition: all .2s;
            }

                .sidebar-menu .nav-link:hover {
                    background: var(--sidebar-hover);
                    color: #fff;
                }

                .sidebar-menu .nav-link.active {
                    background: var(--primary);
                    color: #fff;
                }

                .sidebar-menu .nav-link i {
                    font-size: 1.2rem;
                    width: 24px;
                    text-align: center;
                }

        .sidebar-section {
            padding: 1rem 1.5rem .4rem;
            font-size: .7rem;
            text-transform: uppercase;
            letter-spacing: .08em;
            color: #64748b;
            font-weight: 600;
        }

        /* ========== MAIN CONTENT ========== */
        .main-wrapper {
            margin-left: var(--sidebar-width);
            margin-top: 64px;
            min-height: calc(100vh - 64px);
            display: flex;
            flex-direction: column;
        }

        .main-content {
            flex: 1;
            padding: 1.5rem;
        }

        /* ========== FOOTER ========== */
        .footer {
            background: var(--card-bg);
            border-top: 1px solid var(--border);
            padding: 1rem 1.5rem;
            color: var(--text-secondary);
            font-size: 0.9rem;
            text-align: center;
        }

        /* Mobile sidebar toggle */
        .sidebar-toggle {
            display: none;
            background: none;
            border: none;
            font-size: 1.5rem;
            color: var(--text-primary);
            margin-right: 1rem;
        }

        @@media (max-width: 992px) {
            .sidebar {
                transform: translateX(-100%);
            }

                .sidebar.show {
                    transform: translateX(0);
                }

            .main-wrapper {
                margin-left: 0;
            }

            .sidebar-toggle {
                display: block;
            }
        }
    </style>

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    <!-- ===================== TOP HEADER ===================== -->
    <header class="top-header">
        <button class="sidebar-toggle" id="sidebarToggle" type="button">
            <i class="bi bi-list"></i>
        </button>

        <a class="brand" asp-controller="Home" asp-action="Index">
            <i class="bi bi-receipt-cutoff"></i>
            Sales Invoice
        </a>

        <div class="header-right">
            <a asp-controller="Sale" asp-action="CreateOrEdit" class="btn btn-create">
                <i class="bi bi-plus-circle me-1"></i> Create Invoice
            </a>
        </div>
    </header>

    <!-- ===================== LEFT SIDEBAR ===================== -->
    <aside class="sidebar" id="sidebar">
        <ul class="sidebar-menu">
            <li class="sidebar-section">Main</li>

            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" ? "active" : "")"
                   asp-controller="Home" asp-action="Index">
                    <i class="bi bi-speedometer2"></i>
                    <span>Dashboard</span>
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Sale" ? "active" : "")"
                   asp-controller="Sale" asp-action="Index">
                    <i class="bi bi-receipt"></i>
                    <span>Invoices</span>
                </a>
            </li>

            <li class="sidebar-section">Management</li>

            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Customer" ? "active" : "")"
                   asp-controller="Customer" asp-action="Index">
                    <i class="bi bi-people"></i>
                    <span>Customers</span>
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Product" ? "active" : "")"
                   asp-controller="Product" asp-action="Index">
                    <i class="bi bi-box-seam"></i>
                    <span>Products</span>
                </a>
            </li>

            <li class="sidebar-section">Reports</li>

            <li class="nav-item">
                <a class="nav-link" href="#">
                    <i class="bi bi-bar-chart"></i>
                    <span>Sales Report</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="#">
                    <i class="bi bi-file-earmark-text"></i>
                    <span>Invoice History</span>
                </a>
            </li>
        </ul>
    </aside>

    <!-- ===================== MAIN CONTENT ===================== -->
    <div class="main-wrapper">
        <main class="main-content">
            @RenderBody()
        </main>

        <!-- Footer -->
        <footer class="footer">
            &copy; @DateTime.Now.Year - Sales Invoice Management System
        </footer>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        // Mobile sidebar toggle
        document.getElementById('sidebarToggle')?.addEventListener('click', function () {
            document.getElementById('sidebar').classList.toggle('show');
        });

        // Close sidebar when clicking outside on mobile
        document.addEventListener('click', function (e) {
            const sidebar = document.getElementById('sidebar');
            const toggle = document.getElementById('sidebarToggle');
            if (window.innerWidth <= 992 && sidebar.classList.contains('show')) {
                if (!sidebar.contains(e.target) && !toggle.contains(e.target)) {
                    sidebar.classList.remove('show');
                }
            }
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>



<body>

    <!-- LEFT SIDEBAR -->
    <aside class="sidebar" id="sidebar">
        <div class="sidebar-brand">
            <i class="bi bi-shop"></i>
            Sales Pro
        </div>
        <nav class="sidebar-nav">
            <a asp-controller="Home" asp-action="Index" class="nav-link active">
                <i class="bi bi-speedometer2"></i> Dashboard
            </a>
            <a asp-controller="Sale" asp-action="CreateOrEdit" class="nav-link">
                <i class="bi bi-receipt"></i> Create Invoice
            </a>
            <a asp-controller="Sale" asp-action="Index" class="nav-link">
                <i class="bi bi-list-ul"></i> All Invoices
            </a>
            <a asp-controller="Customer" asp-action="Index" class="nav-link">
                <i class="bi bi-people"></i> Customers
            </a>
            <a asp-controller="Product" asp-action="Index" class="nav-link">
                <i class="bi bi-box-seam"></i> Products
            </a>
            <a href="#" class="nav-link">
                <i class="bi bi-graph-up"></i> Reports
            </a>
            <a href="#" class="nav-link">
                <i class="bi bi-gear"></i> Settings
            </a>
        </nav>
        <div class="sidebar-footer">
            © 2026 Sales Invoice System
        </div>
    </aside>

    <!-- MAIN CONTENT -->
    <div class="main-wrapper">

        <!-- ===================== TOP NAVBAR WITH SEARCH ===================== -->
        <header class="top-navbar">
            <div class="d-flex align-items-center gap-3">
                <button class="btn btn-sm btn-outline-secondary d-lg-none" id="sidebarToggle">
                    <i class="bi bi-list"></i>
                </button>
                <h5 class="mb-0 fw-semibold d-none d-md-block">@ViewData["Title"]</h5>
            </div>

            <!-- GLOBAL SEARCH BAR -->
            <div class="global-search d-none d-md-block">
                <i class="bi bi-search"></i>
                <input type="text"
                       id="globalSearchInput"
                       placeholder="Search customer, product, date..."
                       autocomplete="off" />
            </div>

            <div class="d-flex align-items-center gap-3">
                <!-- Mobile Search Button -->
                <button class="btn btn-sm btn-outline-secondary d-md-none" type="button" data-bs-toggle="collapse" data-bs-target="#mobileSearch">
                    <i class="bi bi-search"></i>
                </button>

                <div class="dropdown">
                    <a class="d-flex align-items-center text-decoration-none dropdown-toggle" href="#" data-bs-toggle="dropdown">
                        <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center"
                             style="width:36px;height:36px;">
                            <i class="bi bi-person"></i>
                        </div>
                        <span class="ms-2 d-none d-md-inline text-dark fw-medium">Admin</span>
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><a class="dropdown-item" href="#"><i class="bi bi-person me-2"></i>Profile</a></li>
                        <li><a class="dropdown-item" href="#"><i class="bi bi-gear me-2"></i>Settings</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item text-danger" href="#"><i class="bi bi-box-arrow-right me-2"></i>Logout</a></li>
                    </ul>
                </div>
            </div>
        </header>

        <!-- Mobile Search (collapsible) -->
        <div class="collapse d-md-none bg-white border-bottom px-3 py-2" id="mobileSearch">
            <div class="global-search">
                <i class="bi bi-search"></i>
                <input type="text"
                       id="globalSearchInputMobile"
                       placeholder="Search customer, product, date..."
                       autocomplete="off" />
            </div>
        </div>

        <!-- Page Content -->
        <main class="container">
            @RenderBody()
        </main>

        <!-- Footer -->
        <footer class="main-footer">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                <span>© 2026 Sales Invoice Management System. All rights reserved.</span>
                <span>Built with <i class="bi bi-heart-fill text-danger"></i> using ASP.NET Core</span>
            </div>
        </footer>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Sidebar Toggle
            const sidebar = document.getElementById("sidebar");
            const toggleBtn = document.getElementById("sidebarToggle");
            if (toggleBtn) {
                toggleBtn.addEventListener("click", () => {
                    sidebar.classList.toggle("show");
                });
            }

            // ========== GLOBAL SEARCH FUNCTION ==========
            function performGlobalSearch(searchText) {
                const rows = document.querySelectorAll("#invoiceTable tbody tr");
                if (rows.length === 0) return; // table না থাকলে কিছু করবে না

                searchText = searchText.toLowerCase().trim();

                rows.forEach(function (row) {
                    const rowText = row.innerText.toLowerCase();
                    if (searchText === "" || rowText.includes(searchText)) {
                        row.style.display = "";
                    } else {
                        row.style.display = "none";
                    }
                });
            }

            // Desktop Search
            const globalSearch = document.getElementById("globalSearchInput");
            if (globalSearch) {
                globalSearch.addEventListener("input", function () {
                    performGlobalSearch(this.value);
                });
            }

            // Mobile Search
            const globalSearchMobile = document.getElementById("globalSearchInputMobile");
            if (globalSearchMobile) {
                globalSearchMobile.addEventListener("input", function () {
                    performGlobalSearch(this.value);
                });
            }
        });
    </script>

    @RenderSection("Scripts", required: false)
</body>
</html>

